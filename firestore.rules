rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Perfil público de cada jugador: lo ve cualquiera, lo edita solo su dueño
    match /jugadores/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.alias is string && request.resource.data.alias.size() > 0 && request.resource.data.alias.size() <= 20
        && request.resource.data.edad is int && request.resource.data.edad >= 14 && request.resource.data.edad <= 90
        && request.resource.data.foto is string && request.resource.data.foto.size() < 200000;
      allow delete: if request.auth != null && request.auth.uid == uid;

      // Datos privados (mail, teléfono): solo el dueño
      match /privado/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Contador anónimo de visitas (sin datos personales): solo se puede sumar de a 1; lo lee solo el administrador
    match /stats/{id} {
      allow read: if request.auth != null && request.auth.uid == 'tzXrEdGyIdWtVk78YpP9PxmImzU2';
      allow create: if id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-z]+$') && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
    }

    // Partidos: los ve cualquiera; los crea un usuario logueado como organizador;
    // cada jugador solo puede anotarse o bajarse a sí mismo (y hasta 3 amigos invitados), sin pasar el cupo.
    match /partidos/{pid} {
      allow read: if true;
      // Partidos de ejemplo (ej-…): solo guardan los jugadores reales que se anotan en los lugares libres
      allow create: if request.auth != null
        && pid in ['ej-ituzaingo', 'ej-sportcenter', 'ej-alasrojas']
        && request.resource.data.keys().hasOnly(['ejemplo', 'libres', 'jugadores'])
        && request.resource.data.libres == {'ej-ituzaingo': 3, 'ej-sportcenter': 1, 'ej-alasrojas': 10}[pid]
        && request.resource.data.jugadores.keys().hasOnly([request.auth.uid]);
      allow create: if request.auth != null
        && request.resource.data.orgUid == request.auth.uid
        && request.resource.data.cupo in [10, 14]
        && request.resource.data.precio is int && request.resource.data.precio >= 0
        && request.resource.data.jugadores.keys().hasOnly([request.auth.uid]);
      allow update: if request.auth != null && (
        (resource.data.get('orgUid', '') == request.auth.uid && request.resource.data.orgUid == resource.data.orgUid)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['jugadores'])
            && request.resource.data.jugadores.diff(resource.data.jugadores).affectedKeys().hasOnly([request.auth.uid, request.auth.uid + '_inv1', request.auth.uid + '_inv2', request.auth.uid + '_inv3'])
            && request.resource.data.jugadores.size() <= resource.data.get('cupo', resource.data.get('libres', 0)))
      );
      allow delete: if request.auth != null && resource.data.get('orgUid', '') == request.auth.uid;
    }
  }
}
